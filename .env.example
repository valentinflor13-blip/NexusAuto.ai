# Ventes fermées par défaut. Ne jamais enregistrer de clé réelle dans Git.
# Node.js 24+, instance unique avec volume persistant pour SQLite et le PDF privé.
APP_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./var/orders.sqlite
CHECKOUT_ENABLED=false
PAYMENT_MODE=test
OFFER_APPROVED=false
ALLOW_LIVE_PAYMENTS=false
PERSISTENT_STORAGE_CONFIRMED=false

# Injecter via le gestionnaire de secrets de l’hébergeur. Clé restreinte recommandée.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
ADMIN_TOKEN=

# Produit final validé : fichier hors public/dist/src, empreinte exacte du PDF.
PRODUCT_PDF_PATH=
PRODUCT_SHA256=
SELLER_NAME=
SUPPORT_EMAIL=
TERMS_URL=
PRIVACY_URL=
TERMS_VERSION=
